{
  // Node 侧配置：用于构建工具与测试工具配置文件的类型检查。
  "extends": "./tsconfig.base.json",
  // 仅覆盖运行在 Node 环境中的配置脚本，不纳入前端业务源码。
  "include": [
    "vite.config.*",
    "vitest.config.*",
    "cypress.config.*",
    "playwright.config.*",
    "eslint.config.*"
  ],
  "compilerOptions": {
    // 作为被引用项目参与 solution build。
    "composite": true,
    // 保留模块语义，让工具链按自身规则处理。
    "module": "preserve",
    // 显式使用 Node 类型，避免环境类型混入。
    "types": ["node"],
    // 仅类型检查，不生成 JS。
    "noEmit": true,
    // Node 侧增量检查缓存位置。
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  }
}
