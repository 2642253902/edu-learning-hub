{
  // 让编辑器在根 tsconfig 层也能读取公共别名与基础编译选项。
  "extends": "./tsconfig.base.json",
  // 解决方案级 tsconfig：
  // 1) 自身不参与编译（files 为空）
  // 2) 通过 references 串联子项目，便于分层类型检查与增量缓存
  "files": [],
  "references": [
    // Node 侧配置（Vite/Vitest/脚本配置文件）
    { "path": "./tsconfig.node.json" },
    // 前端应用配置（Vue + 浏览器环境）
    { "path": "./tsconfig.app.json" }
  ]
}
