<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.exampe.study.mapper.StudyGroupMapper">

    <select id="listGroups" resultType="com.exampe.study.entity.StudyGroup">
        SELECT id, name, description, owner_id, owner_name, create_time
        FROM study_group
        ORDER BY create_time DESC
    </select>

</mapper>
