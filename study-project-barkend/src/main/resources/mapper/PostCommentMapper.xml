<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.exampe.study.mapper.PostCommentMapper">

    <!-- 根据帖子ID查询评论列表，按时间升序排列 -->
    <select id="listByPostId" resultType="com.exampe.study.entity.PostComment">
        SELECT id, post_id, user_id, username, content, create_time
        FROM post_comment
        WHERE post_id = #{postId}
        ORDER BY create_time ASC
    </select>

</mapper>
