<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.exampe.study.mapper.GroupPostMapper">

    <!-- 根据小组ID查询帖子列表，支持空值处理 -->
    <select id="listByGroupId" resultType="com.exampe.study.entity.GroupPost">
        SELECT id, group_id, user_id, username, title, content, comment_count, create_time
        FROM group_post
        <where>
            <if test="groupId != null and groupId != ''">
                group_id = #{groupId}
            </if>
            <if test="groupId == null or groupId == ''">
                (group_id IS NULL OR group_id = '' OR group_id = '0')
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

</mapper>
